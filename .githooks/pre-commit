#!/usr/bin/env bash
# Local gate. Lives in the repository rather than .git/hooks so it is reviewable and shared;
# enable it once per clone with:
#
#     git config core.hooksPath .githooks
#
# It answers "is this commit clean", never "is this code right". Every check here is read-only
# and runs in parallel, so the hook costs about its slowest check, budgeted at five seconds.
# Clippy and the test suite build the workspace; the author runs them before handoff and CI runs
# them again, so they are not repeated here at two minutes a commit.
#
# Set PLEXMATON_SKIP_HOOKS=1 to bypass deliberately; do not remove a check to make a commit pass.
set -euo pipefail

if [[ "${PLEXMATON_SKIP_HOOKS:-0}" == "1" ]]; then
    echo "pre-commit: skipped by PLEXMATON_SKIP_HOOKS" >&2
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"
started=$(perl -MTime::HiRes=time -e 'print time')

# Git exports repository-local variables to hooks. Gates spawn their own fixture repositories;
# let each child resolve its working directory instead of inheriting this repository's authority.
while IFS= read -r variable; do
    [[ -z "$variable" ]] || unset "$variable"
done <<< "$(git rev-parse --local-env-vars)"

gates=(
    "cargo fmt --all --check"
    "./scripts/check-file-length.sh"
    "./scripts/check-crate-graph.sh"
    "./scripts/check-citations.sh"
    "./scripts/check-frames.sh"
)
# The script tests prove the gates themselves, so they run when a gate is what changed.
if [[ -n "$(git diff --cached --name-only -- scripts)" ]]; then
    gates+=("python3 -m unittest discover -s scripts/tests")
fi
# Optional locally, enforced in CI. A missing tool must not silently weaken the commit.
if command -v typos >/dev/null 2>&1; then
    gates+=("typos")
else
    echo "pre-commit: typos not installed, skipping (CI still enforces it)" >&2
fi

logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT
pids=()
for i in "${!gates[@]}"; do
    ${gates[$i]} >"$logs/$i" 2>&1 &
    pids+=("$!")
done

failed=0
for i in "${!gates[@]}"; do
    if wait "${pids[$i]}"; then
        printf '\033[32m✓\033[0m %s\n' "${gates[$i]}"
    else
        failed=1
        printf '\033[31m✗ %s\033[0m\n' "${gates[$i]}"
        sed 's/^/    /' "$logs/$i"
    fi
done

# Reports only. A document over budget is a design question for the author, not a failed commit.
./scripts/check-doc-budget.sh

elapsed=$(perl -MTime::HiRes=time -e 'printf "%.1f", time - $ARGV[0]' "$started")
if [[ "$failed" == 1 ]]; then
    echo "pre-commit: a gate failed after ${elapsed}s" >&2
    exit 1
fi
if (( ${elapsed%.*} >= 5 )); then
    printf '\033[31mpre-commit: %d gates passed in %ss; the budget is 5s\033[0m\n' "${#gates[@]}" "$elapsed"
else
    echo "pre-commit: ${#gates[@]} gates passed in ${elapsed}s"
fi
